@using OpenFindBearings.Identity.Constants
@{
    Layout = "_Layout.Login";
    ViewData["Title"] = "登录";

    var realmName = ViewBag.RealmDisplayName ?? TenantConstants.SystemDisplayName;
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1 class="login-title">OpenFindBearings</h1>
            <p class="login-subtitle">@realmName</p>
        </div>

        @if (ViewBag.Success != null)
        {
            <div class="alert" style="background:#f0fff4;color:#276749;border:1px solid #9ae6b4;" role="alert">
                @ViewBag.Success
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-controller="Login" asp-action="LoginSubmit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="hidden" name="realm" value="@ViewBag.Realm" />

            <div class="form-group">
                <label for="username">用户名</label>
                <input type="text" class="form-control" id="username" name="username"
                       placeholder="请输入用户名" required autofocus />
            </div>

            <div class="form-group">
                <label for="password">密码</label>
                <input type="password" class="form-control" id="password" name="password"
                       placeholder="请输入密码" required />
            </div>

            <button type="submit" class="btn btn-primary btn-block">登录</button>
        </form>
    </div>
</div>
