@model UpdateUserDto
@using OpenFindBearings.Identity.Models.DTOs.User
@using OpenFindBearings.Identity.Models.DTOs.Role
@{
    ViewData["Title"] = "编辑用户";
    UserDto user = ViewBag.User;
    var roles = (IReadOnlyList<RoleDto>)ViewBag.Roles;
    var userRoles = (HashSet<string>)ViewBag.UserRoles;
}

<h2>编辑用户</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@* 只读基础信息 *@
<h5 class="text-muted">基础信息（只读）</h5>
<div class="row mb-3">
    <div class="col-md-3"><label class="form-label">用户名</label><input class="form-control" value="@user.UserName" readonly disabled /></div>
    <div class="col-md-3"><label class="form-label">状态</label><input class="form-control" value="@(user.IsEnabled ? "启用" : "禁用")" readonly disabled /></div>
    <div class="col-md-6"><label class="form-label">角色（只读）</label><input class="form-control" value="@string.Join("、", userRoles)" readonly disabled /></div>
</div>
<div class="row mb-3">
<div class="col-md-4"><label class="form-label">创建时间</label>@* v2.18.0 时间治理：input 也走 data-utc，全局 JS 填充 value *@<input class="form-control" data-utc="@user.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")" value="@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")" readonly disabled /></div>
<div class="col-md-4"><label class="form-label">最后登录</label><input class="form-control" @Html.Raw(user.LastLoginAt.HasValue ? "data-utc=\"" + user.LastLoginAt.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") + "\"" : "") value="@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "从未登录")" readonly disabled /></div>
</div>

@* 可编辑资料 *@
<h5 class="text-muted">资料信息</h5>
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@ViewBag.UserId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="GivenName" class="form-label"></label>
            <input asp-for="GivenName" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="FamilyName" class="form-label"></label>
            <input asp-for="FamilyName" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Nickname" class="form-label"></label>
            <input asp-for="Nickname" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Gender" class="form-label"></label>
            <input asp-for="Gender" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Birthdate" class="form-label"></label>
            <input asp-for="Birthdate" class="form-control" type="date" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PictureUrl" class="form-label"></label>
            <input asp-for="PictureUrl" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="WebsiteUrl" class="form-label"></label>
            <input asp-for="WebsiteUrl" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Locale" class="form-label"></label>
            <input asp-for="Locale" class="form-control" placeholder="如 zh-CN" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ZoneInfo" class="form-label"></label>
            <input asp-for="ZoneInfo" class="form-control" placeholder="如 Asia/Shanghai" />
        </div>
    </div>

    @* 角色分配 *@
    <div class="mb-3">
        <label class="form-label">角色</label>
        <div>
            @foreach (var role in roles)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="roles" value="@role.Name"
                           id="role-@role.Id" @(userRoles.Contains(role.Name) ? "checked" : "") />
                    <label class="form-check-label" for="role-@role.Id">@role.Name</label>
                </div>
            }
        </div>
        <div class="form-text">勾选保存会整体替换该用户的角色集合。</div>
    </div>

    <button type="submit" class="btn btn-primary">保存</button>
    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}