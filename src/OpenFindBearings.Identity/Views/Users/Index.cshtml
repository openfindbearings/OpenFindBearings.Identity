@using OpenFindBearings.Identity.Models.DTOs.User
@using OpenFindBearings.Identity.Models.DTOs.Tenant
@model PaginatedResult<UserDto>
@{
    ViewData["Title"] = "用户管理";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">用户管理</h1>
    <a asp-action="Create" class="btn btn-primary">新建用户</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" class="form-control" placeholder="搜索用户名/邮箱..." value="@ViewBag.Search" />
    </div>
    <div class="col-auto">
        <select name="tenantId" class="form-select" onchange="this.form.submit()">
            <option value="">全部租户</option>
            @foreach (TenantDto t in ViewBag.Tenants)
            {
                <option value="@t.Id" selected="@(ViewBag.TenantId == t.Id ? true : null)">
                    @t.Name
                </option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜索</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>用户名</th>
                <th>邮箱</th>
                <th>手机号</th>
                <th>租户</th>
                <th>状态</th>
                <th>创建时间</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.UserName</td>
                    <td>@item.Email</td>
                    <td>@item.PhoneNumber</td>
                    <td>
                        @{
                            string? tenantDisplay = null;
                            if (item.TenantId.HasValue)
                                ViewBag.TenantNames.TryGetValue(item.TenantId.Value, out tenantDisplay);
                        }
                        @if (tenantDisplay != null)
                        {
                            @tenantDisplay
                        }
                        else
                        {
                            <span class="text-muted">系统</span>
                        }
                    </td>
                    <td>
                        <span class="badge @(item.IsEnabled ? "bg-success" : "bg-secondary")">
                            @(item.IsEnabled ? "启用" : "禁用")
                        </span>
                    </td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-@(item.IsEnabled ? "warning" : "success")">
                                @(item.IsEnabled ? "禁用" : "启用")
                            </button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#resetPwdModal-@item.Id">重置密码</button>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('确定删除用户 @item.UserName？')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                        </form>

                        <div class="modal fade" id="resetPwdModal-@item.Id" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">重置密码 - @item.UserName</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="ResetPassword" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label">新密码</label>
                                                <input type="password" name="newPassword" class="form-control" minlength="6" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                                            <button type="submit" class="btn btn-primary">确认重置</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">暂无用户</td></tr>
            }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-tenantId="@ViewBag.TenantId">@i</a>
            </li>
        }
    </ul>
</nav>
