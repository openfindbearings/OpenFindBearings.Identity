@using OpenFindBearings.Identity.Models.DTOs.Tenant
@model CreateScopeDto
@{
    ViewData["Title"] = "新建 Scope";
}

<h2>新建 Scope</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="TenantId" class="form-label">所属租户</label>
        <select asp-for="TenantId" class="form-select" asp-items="@(new SelectList(ViewBag.Tenants, "Id", "Name"))">
            <option value="">-- 请选择租户 --</option>
        </select>
        <span asp-validation-for="TenantId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">名称</label>
        <input asp-for="Name" class="form-control" placeholder="api:example" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <div class="form-text">建议格式：api:系统名</div>
    </div>

    <div class="mb-3">
        <label asp-for="DisplayName" class="form-label"></label>
        <input asp-for="DisplayName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">创建</button>
    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
