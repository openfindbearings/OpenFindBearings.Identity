@using OpenFindBearings.Identity.Models.DTOs.Tenant
@model CreateScopeDto
@{
    ViewData["Title"] = "新建 Scope";
}

<h2>新建 Scope</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="TenantId" class="form-label">所属租户</label>
        <select asp-for="TenantId" class="form-select" asp-items="@(new SelectList(ViewBag.Tenants, "Id", "Name"))">
            <option value="">-- 请选择租户 --</option>
        </select>
        <span asp-validation-for="TenantId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">名称</label>
        <input asp-for="Name" class="form-control" placeholder="api:example" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <div class="form-text">建议格式：api:系统名</div>
    </div>

    <div class="mb-3">
        <label asp-for="DisplayName" class="form-label"></label>
        <input asp-for="DisplayName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    @* 改动说明：新建也暴露受众输入（此前 Resources 恒为 null，无法在建时设定） *@
    <div class="mb-3">
        <label asp-for="ResourcesText" class="form-label">受众 / 资源（Audience）</label>
        <textarea asp-for="ResourcesText" class="form-control" rows="4" placeholder="openfindbearings-api&#10;openfindbearings-sync"></textarea>
        <div class="form-text">每行一个受众（也可逗号分隔）。令牌请求该 scope 时，这些值会进入 access token 的 aud。</div>
    </div>

    <button type="submit" class="btn btn-primary">创建</button>
    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
