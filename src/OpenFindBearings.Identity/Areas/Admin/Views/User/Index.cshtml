@model UserListViewModel
@{
    ViewData["Title"] = "用户管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>用户管理</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> 新建用户
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-3">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="搜索用户名/邮箱/姓名" value="@Model.SearchKeyword" />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">全部状态</option>
                    <option value="Enabled" selected="@(Model.StatusFilter == UserStatusFilter.Enabled)">已启用</option>
                    <option value="Disabled" selected="@(Model.StatusFilter == UserStatusFilter.Disabled)">已禁用</option>
                    <option value="Locked" selected="@(Model.StatusFilter == UserStatusFilter.Locked)">已锁定</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">搜索</button>
            </div>
            <div class="col-md-2">
                <a href="@Url.Action("Index")" class="btn btn-secondary w-100">重置</a>
            </div>
        </form>

        <table>
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Display.UserName)</th>
                    <th>@Html.DisplayNameFor(m => m.Display.Email)</th>
                    <th>@Html.DisplayNameFor(m => m.Display.PhoneNumber)</th>
                    <th>@Html.DisplayNameFor(m => m.Display.Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Display.IsEnabled)</th>
                    <th>@Html.DisplayNameFor(m => m.Display.LastLoginAt)</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users.Items)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td>@user.Name</td>
                        <td>
                            @if (user.IsEnabled && user.IsActive)
                            {
                                <span class="badge bg-success">已启用</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">已禁用</span>
                            }
                            @if (user.IsActive == false)
                            {
                                <span class="badge bg-secondary">已删除</span>
                            }
                        </td>
                        <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td class="table-actions">
                            <a href="@Url.Action("Details", new { id = user.Id })" class="btn btn-sm btn-info">详情</a>
                            <a href="@Url.Action("Edit", new { id = user.Id })" class="btn btn-sm btn-primary">编辑</a>
                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteUser('@user.Id')">删除</button>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center">暂无数据</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Users.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @if (Model.Users.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.Users.PageIndex - 1, search = Model.SearchKeyword, status = Model.StatusFilter })">上一页</a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.Users.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Users.PageIndex ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.SearchKeyword, status = Model.StatusFilter })">@i</a>
                        </li>
                    }
                    @if (Model.Users.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.Users.PageIndex + 1, search = Model.SearchKeyword, status = Model.StatusFilter })">下一页</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        function deleteUser(id) {
            if (confirm('确定要删除此用户吗？')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("Delete")' + '?id=' + id;
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}