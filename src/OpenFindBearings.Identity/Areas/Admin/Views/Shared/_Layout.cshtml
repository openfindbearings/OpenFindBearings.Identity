<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 管理后台</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
            .sidebar {
                min-height: 100vh;
                background-color: #343a40;
            }
            .sidebar .nav-link {
                color: #fff;
            }
            .sidebar .nav-link:hover {
                background-color: #495057;
            }
            .sidebar .nav-link.active {
                background-color: #007bff;
            }
            .main-content {
                padding: 20px;
            }
            .navbar-brand {
                font-weight: bold;
            }
            .table-actions {
                white-space: nowrap;
            }
            .table-actions .btn {
                margin-right: 5px;
                padding: 2px 8px;
                font-size: 12px;
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- 侧边栏 -->
            <nav class="col-md-2 d-md-block sidebar p-0">
                <div class="position-sticky">
                    <div class="p-3 text-white text-center border-bottom">
                        <h5>管理后台</h5>
                        <small>Identity Server</small>
                    </div>
                    <ul class="nav flex-column mt-3">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                                <i class="bi bi-speedometer2"></i> 仪表盘
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "User", new { area = "Admin" })">
                                <i class="bi bi-people"></i> 用户管理
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Role", new { area = "Admin" })">
                                <i class="bi bi-person-badge"></i> 角色管理
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Client", new { area = "Admin" })">
                                <i class="bi bi-app"></i> 客户端
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Scope", new { area = "Admin" })">
                                <i class="bi bi-tag"></i> 资源/Scope
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "AuditLog", new { area = "Admin" })">
                                <i class="bi bi-file-text"></i> 审计日志
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "SystemConfig", new { area = "Admin" })">
                                <i class="bi bi-gear"></i> 系统配置
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- 主内容区 -->
            <main class="col-md-10 ms-sm-auto px-md-4 main-content">
                <!-- 顶部导航 -->
                <nav class="navbar navbar-light bg-light rounded mb-3">
                    <div class="container-fluid">
                        <span class="navbar-text">
                            @ViewData["Title"]
                        </span>
                        <div class="d-flex">
                            <span class="navbar-text me-3">
                                欢迎，@(User.Identity?.Name ?? "管理员")
                            </span>
                            <a href="@Url.Action("Logout", "Account", new { area = "" })" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-box-arrow-right"></i> 退出
                            </a>
                        </div>
                    </div>
                </nav>

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>